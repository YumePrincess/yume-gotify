{
  "name": "yume-gotify",
  "private": true,
  "description": "A serverless, multilingual Gotify 3-compatible notification service deployed on Cloudflare Workers, with realtime delivery and a web client.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/ensure-wrangler-config.mjs",
    "build": "pnpm run build:plugins && tsc -b && vite build",
    "build:plugins": "pnpm -r --filter './plugins/*' run build",
    "precf-typegen": "node scripts/ensure-wrangler-config.mjs",
    "cf-typegen": "wrangler types",
    "precheck": "node scripts/ensure-wrangler-config.mjs",
    "check": "pnpm run build:plugins && tsc && vite build && wrangler deploy --dry-run",
    "predeploy": "node scripts/ensure-wrangler-config.mjs",
    "deploy": "wrangler deploy",
    "precloudflare:deploy": "node scripts/ensure-wrangler-config.mjs",
    "cloudflare:deploy": "wrangler deploy",
    "precloudflare:preview": "node scripts/ensure-wrangler-config.mjs",
    "cloudflare:preview": "wrangler versions upload",
    "predev": "node scripts/ensure-wrangler-config.mjs",
    "dev": "pnpm run build:plugins && vite",
    "lint": "oxlint . --fix",
    "format": "oxfmt . --write",
    "preview": "npm run build && vite preview",
    "pretest": "node scripts/ensure-wrangler-config.mjs",
    "test": "pnpm run build:plugins && vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gotify/client-token-cleanup": "workspace:*",
    "@gotify/message-auto-delete": "workspace:*",
    "@gotify/sdk": "workspace:*",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@uiw/codemirror-theme-material": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "bcryptjs": "^3.0.3",
    "detect-browser": "^5.3.0",
    "fractional-indexing": "^4.0.0",
    "hono": "4.12.31",
    "js-yaml": "^5.2.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "mobx-utils": "^6.1.1",
    "notifyjs": "^3.0.0",
    "notistack": "^3.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "react-timeago": "^8.3.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "remove-markdown": "^0.6.4",
    "tss-react": "^4.9.21"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^26.1.1",
    "@types/notifyjs": "^3.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "globals": "17.7.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "cloudflare": {
    "label": "Yume Gotify",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true
  }
}
